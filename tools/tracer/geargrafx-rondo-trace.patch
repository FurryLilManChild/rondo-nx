@@ -0,0 +1,16 @@
+include ../shared/makefiles/Makefile.sources
+CORE_C := $(filter $(DEPS_DIR)/libchdr/% $(DEPS_DIR)/lzma/% $(DEPS_DIR)/miniz/% $(DEPS_DIR)/minivorbis/%,$(SOURCES_C))
+CORE_CXX := $(filter $(SRC_DIR)/%,$(SOURCES_CXX))
+OBJS := $(patsubst %.c,obj/%.o,$(notdir $(CORE_C))) $(patsubst %.cpp,obj/%.o,$(notdir $(CORE_CXX))) obj/main.o obj/qon.o
+vpath %.c $(sort $(dir $(CORE_C)))
+vpath %.cpp $(sort $(dir $(CORE_CXX))) . $(DEPS_DIR)/qon
+INC := -I$(SRC_DIR) -I$(DEPS_DIR)/libchdr/include -I$(DEPS_DIR)/lzma/include -I$(DEPS_DIR)/miniz -I$(DEPS_DIR)/minivorbis -I$(DEPS_DIR)/stb -I$(DEPS_DIR)/zstd -I$(DEPS_DIR)/json -I$(DEPS_DIR)/qon
