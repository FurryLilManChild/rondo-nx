diff --git a/platforms/headless/main.cpp b/platforms/headless/main.cpp
new file mode 100644
index 0000000..2b83978
--- /dev/null
+++ b/platforms/headless/main.cpp
@@ -0,0 +1,103 @@
+// Headless runner for testing the rondo tracer.
+// usage: headless <cue> <bios> <frames> <script> <outdir>
+// script lines: "<frame> press|release <KEY>", "<frame> shot", "<frame> cheat <code>",
+//               "<frame> save <path>", "<frame> load <path>"
+#include "geargrafx.h"
+#include "rondo_trace.h"
+#include "memory_inline.h"
+bool g_mcp_stdio_mode = false;
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <string>
+#include <vector>
+#define STB_IMAGE_WRITE_IMPLEMENTATION
+#include "stb_image_write.h"
+
+#include <map>
+#include <algorithm>
+extern std::map<u32,u32> g_rt_hist; extern bool g_rt_hist_on;
+struct Ev { int frame; std::string cmd, arg; };
+
+static GG_Keys key_of(const std::string& s)
+{
+    if (s == "I") return GG_KEY_I; if (s == "II") return GG_KEY_II;
+    if (s == "SELECT") return GG_KEY_SELECT; if (s == "RUN") return GG_KEY_RUN;
+    if (s == "UP") return GG_KEY_UP; if (s == "DOWN") return GG_KEY_DOWN;
+    if (s == "LEFT") return GG_KEY_LEFT; if (s == "RIGHT") return GG_KEY_RIGHT;
+    return GG_KEY_NONE;
+}
+
+int main(int argc, char** argv)
+{
+    if (argc < 6) { printf("usage\n"); return 1; }
+    int frames = atoi(argv[3]);
+    std::string out = argv[5];
+    std::vector<Ev> evs;
+    FILE* sf = fopen(argv[4], "r");
+    char line[512];
+    while (sf && fgets(line, sizeof(line), sf))
+    {
+        char cmd[64] = {0}, arg[400] = {0}; int fr;
+        if (line[0] == '#') continue;
+        int n = sscanf(line, "%d %63s %399[^\n]", &fr, cmd, arg);
+        if (n >= 2) evs.push_back({fr, cmd, n == 3 ? arg : ""});
+    }
+    if (sf) fclose(sf);
+
+    rondo_trace_init(out.c_str());
+    GeargrafxCore* core = new GeargrafxCore();
+    core->Init(NULL, GG_PIXEL_RGBA8888);
+    if (!core->LoadBios(argv[2], true)) { printf("bios fail\n"); return 1; }
+    if (!core->LoadMedia(argv[1])) { printf("media fail\n"); return 1; }
+
+    std::vector<u8> fb(2048 * 512 * 4);
+    std::vector<s16> snd(48000);
+    for (int f = 0; f < frames; f++)
+    {
+        for (size_t i = 0; i < evs.size(); i++)
+        {
+            if (evs[i].frame != f) continue;
+            const std::string& c = evs[i].cmd;
+            if (c == "press") core->KeyPressed(GG_CONTROLLER_1, key_of(evs[i].arg));
+            else if (c == "release") core->KeyReleased(GG_CONTROLLER_1, key_of(evs[i].arg));
+            else if (c == "cheat") core->SetCheat(evs[i].arg.c_str());
+            else if (c == "save") core->SaveState(evs[i].arg.c_str());
+            else if (c == "load") core->LoadState(evs[i].arg.c_str());
+            else if (c == "peek")
+            {
+                unsigned b, o, n; sscanf(evs[i].arg.c_str(), "%x %x %u", &b, &o, &n);
+                u8* m = core->GetMemory()->GetMemoryMap()[b];
+                printf("f%d peek %02X:%04X:", f, b, o);
+                for (unsigned k = 0; k < n; k++) printf(" %02X", m[o + k]);
+                printf("\n");
+            }
+            else if (c == "histon") { g_rt_hist.clear(); g_rt_hist_on = true; }
+            else if (c == "histoff")
+            {
+                g_rt_hist_on = false;
+                std::vector<std::pair<u32,u32> > v;
+                for (std::map<u32,u32>::iterator it = g_rt_hist.begin(); it != g_rt_hist.end(); ++it) v.push_back(std::make_pair(it->second, it->first));
+                std::sort(v.rbegin(), v.rend());
+                for (size_t k = 0; k < v.size() && k < 100000; k++) printf("  %02X:%04X %u\n", v[k].second >> 16, v[k].second & 0xFFFF, v[k].first);
+            }
+            else if (c == "poke")
+            {
+                unsigned b, o; char hex[300]; sscanf(evs[i].arg.c_str(), "%x %x %299s", &b, &o, hex);
+                u8* m = core->GetMemory()->GetMemoryMap()[b];
+                for (unsigned k = 0; hex[k*2] && hex[k*2+1]; k++) { unsigned v; sscanf(hex + k*2, "%2x", &v); m[o + k] = (u8)v; }
+            }
+            else if (c == "shot")
+            {
+                GG_Runtime_Info ri; core->GetRuntimeInfo(ri);
+                char p[600]; snprintf(p, sizeof(p), "%s/shot_%06d.png", out.c_str(), f);
+                stbi_write_png(p, ri.screen_width, ri.screen_height, 4, fb.data(), ri.screen_width * 4);
+            }
+        }
+        int sc = 0;
+        core->RunToVBlank(fb.data(), snd.data(), &sc);
+    }
+    rondo_trace_save();
+    char st[128]; rondo_trace_status(st, sizeof(st)); printf("%s\n", st);
+    return 0;
+}
